  "techniques": [
    {
      "id": "foot_in_door",
      "name": "Foot-in-the-Door",
      "name_cs": "Noha ve dveřích",
      "category": "commitment_consistency",
      "description": "Starting with small request to increase compliance with larger request",
      "psychological_mechanism": "Self-perception theory and cognitive consistency",
      "attack_sequence": [
        "Make small, easily agreeable request",
        "Wait for compliance and commitment",
        "Escalate to larger target request",
        "Frame as consistent with prior behavior"
      ],
      "detection_markers": [
        "Escalating request pattern",
        "Appeals to prior commitments",
        "Consistency reminders"
      ],
      "linguistic_patterns": [
        "since you already",
        "you've shown",
        "consistent with",
        "as someone who",
        "building on"
      ],
      "countermeasures": [
        "Evaluate each request independently",
        "Recognize escalation patterns",
        "Feel free to change position"
      ],
      "effectiveness_rating": 0.75,
      "detection_difficulty": 0.6,
      "research_refs": ["Freedman1966", "Cialdini2006", "Burger1999"]
    },
    {
      "id": "door_in_face",
      "name": "Door-in-the-Face",
      "name_cs": "Dveře do tváře",
      "category": "reciprocity",
      "description": "Making large request first, then retreating to smaller target request",
      "psychological_mechanism": "Reciprocal concession and contrast effect",
      "attack_sequence": [
        "Make unreasonably large initial request",
        "Accept rejection gracefully",
        "Make smaller 'concession' (actual target)",
        "Frame as compromise"
      ],
      "detection_markers": [
        "Extreme initial request",
        "Quick concession pattern",
        "Pressure to reciprocate concession"
      ],
      "linguistic_patterns": [
        "I understand that's too much",
        "how about instead",
        "I'll meet you halfway",
        "compromise",
        "at least"
      ],
      "countermeasures": [
        "Evaluate final request on merits",
        "Don't feel obligated to reciprocate",
        "Take time before responding"
      ],
      "effectiveness_rating": 0.70,
      "detection_difficulty": 0.5,
      "research_refs": ["Cialdini1975", "O'Keefe1999", "Pascual2016"]
    },
    {
      "id": "lowballing",
      "name": "Lowballing",
      "name_cs": "Nízká nabídka",
      "category": "commitment_consistency",
      "description": "Securing commitment with attractive offer, then changing terms",
      "psychological_mechanism": "Commitment and sunk cost after initial agreement",
      "attack_sequence": [
        "Present highly attractive initial offer",
        "Obtain commitment/agreement",
        "Reveal hidden costs or change terms",
        "Maintain commitment through consistency pressure"
      ],
      "detection_markers": [
        "Too-good-to-be-true initial offers",
        "Late revelation of terms",
        "Pressure to maintain commitment"
      ],
      "linguistic_patterns": [
        "just one thing",
        "small additional",
        "I forgot to mention",
        "you're already committed",
        "we've come this far"
      ],
      "countermeasures": [
        "Get all terms in writing upfront",
        "Be willing to walk away",
        "Re-evaluate after any change"
      ],
      "effectiveness_rating": 0.65,
      "detection_difficulty": 0.4,
      "research_refs": ["Cialdini1978", "Burger2003", "Guéguen2002"]
    },
    {
      "id": "social_proof_manufacturing",
      "name": "Social Proof Manufacturing",
      "name_cs": "Výroba sociálního důkazu",
      "category": "social_proof",
      "description": "Creating artificial appearance of widespread adoption or approval",
      "psychological_mechanism": "Informational social influence and conformity",
      "attack_sequence": [
        "Create visible 'crowd' behavior (real or fake)",
        "Emphasize popularity metrics",
        "Suggest consensus among peers",
        "Create fear of missing out"
      ],
      "detection_markers": [
        "Unverifiable popularity claims",
        "Fake reviews/testimonials",
        "Manufactured urgency"
      ],
      "linguistic_patterns": [
        "everyone is",
        "millions have",
        "fastest growing",
        "don't miss out",
        "join now"
      ],
      "countermeasures": [
        "Verify popularity independently",
        "Check for fake reviews",
        "Evaluate on personal merits"
      ],
      "effectiveness_rating": 0.80,
      "detection_difficulty": 0.5,
      "research_refs": ["Cialdini2006", "Luca2016", "Muchnik2013"]
    },
    {
      "id": "scarcity_fabrication",
      "name": "Scarcity Fabrication",
      "name_cs": "Fabricace nedostatku",
      "category": "scarcity",
