        "you're imagining",
        "you're too sensitive",
        "everyone thinks you're",
        "you're remembering wrong"
      ],
      "countermeasures": [
        "Document events contemporaneously",
        "Seek external validation",
        "Trust your perceptions",
        "Maintain support network"
      ],
      "effectiveness_rating": 0.90,
      "detection_difficulty": 0.75,
      "ethical_severity": "critical",
      "research_refs": ["Stern2007", "Sweet2019", "Abramson2014"]
    },
