{
  "$id": "detection_patterns.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Aggregated detection patterns across all techniques",
  "properties": {
    "patterns": {
      "items": {
        "properties": {
          "category": {
            "type": "string"
          },
          "pattern": {
            "type": "string"
          },
          "severity_score": {
            "type": "number"
          },
          "technique_id": {
            "type": "string"
          }
        },
        "required": [
          "pattern",
          "technique_id"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "total_patterns": {
      "type": "integer"
    }
  },
  "required": [
    "total_patterns",
    "patterns"
  ],
  "title": "All Detection Patterns",
  "type": "object"
}