{
  "$id": "pattern_category.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Detection patterns grouped by technique category",
  "properties": {
    "aggregate_reversibility": {
      "type": "number"
    },
    "aggregate_severity": {
      "type": "number"
    },
    "category": {
      "type": "string"
    },
    "patterns": {
      "items": {
        "properties": {
          "defense_strategies": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "detection_patterns": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "manifestations": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "name_cs": {
            "type": "string"
          },
          "name_en": {
            "type": "string"
          },
          "severity_score": {
            "type": "number"
          },
          "technique_id": {
            "type": "string"
          }
        },
        "required": [
          "technique_id",
          "name_cs",
          "severity_score"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "technique_count": {
      "type": "integer"
    }
  },
  "required": [
    "category",
    "technique_count",
    "patterns"
  ],
  "title": "Detection Pattern Category",
  "type": "object"
}