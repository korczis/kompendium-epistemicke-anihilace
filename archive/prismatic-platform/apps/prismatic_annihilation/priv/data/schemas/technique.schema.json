{
  "$id": "technique.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Schema for individual epistemic/cognitive annihilation technique from the compendium",
  "properties": {
    "category": {
      "description": "Primary category classification",
      "type": "string"
    },
    "cross_references": {
      "description": "References to related techniques (slugified anchors)",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "defense_strategies": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "description": {
      "properties": {
        "cs": {
          "type": [
            "string",
            "null"
          ]
        },
        "en": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "detection_patterns": {
      "description": "Patterns useful for detecting this technique",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "domain": {
      "description": "Domain of operation",
      "type": "string"
    },
    "example": {
      "properties": {
        "cs": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "id": {
      "description": "Unique technique identifier",
      "pattern": "^EA-\\d{3}-.+$",
      "type": "string"
    },
    "metadata": {
      "description": "Extraction and processing metadata",
      "type": "object"
    },
    "name": {
      "properties": {
        "cs": {
          "description": "Czech name",
          "type": "string"
        },
        "en": {
          "description": "English translation",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "cs"
      ],
      "type": "object"
    },
    "page_number": {
      "description": "Page number in original compendium",
      "type": [
        "integer",
        "null"
      ]
    },
    "reversibility": {
      "properties": {
        "level": {
          "enum": [
            "practically_irreversible",
            "very_difficult",
            "difficult",
            "highly_resistant",
            "moderately_difficult",
            "partially_reversible",
            "low_reversibility",
            "irreversible",
            "very_low",
            "unknown"
          ],
          "type": "string"
        },
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        }
      },
      "required": [
        "level",
        "score"
      ],
      "type": "object"
    },
    "severity": {
      "properties": {
        "level": {
          "enum": [
            "extreme",
            "critical",
            "high",
            "medium_high",
            "medium",
            "low",
            "unknown"
          ],
          "type": "string"
        },
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "type": "number"
        }
      },
      "required": [
        "level",
        "score"
      ],
      "type": "object"
    },
    "subcategory": {
      "description": "Subcategory within primary category",
      "type": [
        "string",
        "null"
      ]
    },
    "temporal_profile": {
      "description": "Temporal characteristics",
      "type": "string"
    },
    "typical_manifestations": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "id",
    "name",
    "category",
    "severity"
  ],
  "title": "Epistemic Annihilation Technique",
  "type": "object"
}